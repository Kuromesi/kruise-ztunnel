*filter
-F ISTIO_FW_FILTER_IN
-F ISTIO_FW_FILTER_OUT
-A ISTIO_FW_FILTER_IN -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A ISTIO_FW_FILTER_OUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A ISTIO_FW_FILTER_IN -i lo -j ACCEPT
-A ISTIO_FW_FILTER_OUT -o lo -j ACCEPT
-A ISTIO_FW_FILTER_OUT -m owner --uid-owner 1337 -j RETURN
-A ISTIO_FW_FILTER_OUT -m owner --gid-owner 1337 -j RETURN
-A ISTIO_FW_FILTER_IN -s 192.168.0.0/16 -p udp --dport 443 -j REJECT
-A ISTIO_FW_FILTER_IN -s 192.168.0.0/16 -p sctp --dport 443 -j REJECT
-A ISTIO_FW_FILTER_IN -s 10.0.0.0/8 -p udp --dport 80 -j REJECT
-A ISTIO_FW_FILTER_IN -s 10.0.0.0/8 -p sctp --dport 80 -j REJECT
-A ISTIO_FW_FILTER_OUT -d 172.16.0.0/12 -p udp --dport 8080 -j ACCEPT
-A ISTIO_FW_FILTER_OUT -d 172.16.0.0/12 -p sctp --dport 8080 -j ACCEPT
COMMIT
