add table inet ztunnel
delete table inet ztunnel
table inet ztunnel {
  chain zt_policy_input {
    type filter hook input priority -150; policy accept;
    ct state established,related accept
    iif lo accept
    ip saddr 192.168.0.0/16 meta l4proto { udp, sctp } th dport 443 reject comment "high-priority"
    ip saddr 10.0.0.0/8 meta l4proto { udp, sctp } th dport 80 reject comment "low-priority"
  }
  chain zt_policy_output {
    type filter hook output priority -150; policy accept;
    ct state established,related accept
    oif lo accept
    meta skuid 1337 return
    meta skgid 1337 return
    ip daddr 172.16.0.0/12 meta l4proto { udp, sctp } th dport 8080 accept comment "outbound-allow"
  }
}
