*filter
-F ISTIO_FW_FILTER_IN
-F ISTIO_FW_FILTER_OUT
-A ISTIO_FW_FILTER_IN -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A ISTIO_FW_FILTER_OUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A ISTIO_FW_FILTER_IN -i lo -j ACCEPT
-A ISTIO_FW_FILTER_OUT -o lo -j ACCEPT
-A ISTIO_FW_FILTER_OUT -m owner --uid-owner 1337 -j RETURN
-A ISTIO_FW_FILTER_OUT -m owner --gid-owner 1337 -j RETURN
-A ISTIO_FW_FILTER_IN -s 10.0.0.0/8 -d 192.168.1.0/24 -p udp --dport 443 -j REJECT
-A ISTIO_FW_FILTER_IN -s 10.0.0.0/8 -d 192.168.1.0/24 -p sctp --dport 443 -j REJECT
-A ISTIO_FW_FILTER_IN -s 10.0.0.0/8 -d 192.168.2.0/24 -p udp --dport 443 -j REJECT
-A ISTIO_FW_FILTER_IN -s 10.0.0.0/8 -d 192.168.2.0/24 -p sctp --dport 443 -j REJECT
-A ISTIO_FW_FILTER_IN -s 172.16.0.0/12 -d 192.168.1.0/24 -p udp --dport 443 -j REJECT
-A ISTIO_FW_FILTER_IN -s 172.16.0.0/12 -d 192.168.1.0/24 -p sctp --dport 443 -j REJECT
-A ISTIO_FW_FILTER_IN -s 172.16.0.0/12 -d 192.168.2.0/24 -p udp --dport 443 -j REJECT
-A ISTIO_FW_FILTER_IN -s 172.16.0.0/12 -d 192.168.2.0/24 -p sctp --dport 443 -j REJECT
COMMIT
